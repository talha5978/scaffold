{
	"extends": "../../tsconfig.json",
	"include": [".react-router/types/**/*", "app/**/*", "vite.config.ts", "react-router.config.ts"],
	"references": [{ "path": "../../packages/core" }, { "path": "../../packages/generator" }],
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node", "vite/client"],
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"~/*": ["./app/*"]
		},
		"noEmit": true
	}
}
