import type { FastifyInstance, FastifyRequest, FastifyReply } from 'fastify';
import { eq, like, or, count, desc } from 'drizzle-orm';
import { <%= entity.tableName %> } from '@workspace/db';
import { ApiError } from '~/utils/ApiError';

export async function <%= entity.tableName %>Routes(fastify: FastifyInstance) {
  // GET List (Paginated + Search)
  fastify.get('/<%= entity.tableName %>', async (request: FastifyRequest, reply: FastifyReply) => {
    const { page = 1, limit = 10, search = '' } = request.query as {
      page?: number;
      limit?: number;
      search?: string;
    };
    const offset = (Number(page) - 1) * Number(limit);

    const whereClause = search
      ? or(
<% if (page && page.searchableFields.length > 0) { -%>
<% page.searchableFields.forEach(field => { -%>
          like(<%= entity.tableName %>.<%= field %>, `%${search}%`),
<% }); -%>
<% } else { -%>
          like(<%= entity.tableName %>.id, `%${search}%`),
<% } -%>
        )
      : undefined;

    const [records, totalResult] = await Promise.all([
      fastify.db
        .select()
        .from(<%= entity.tableName %>)
        .where(whereClause)
        .limit(Number(limit))
        .offset(offset)
        .orderBy(desc(<%= entity.tableName %>.createdAt)),
      fastify.db.select({ value: count() }).from(<%= entity.tableName %>).where(whereClause),
    ]);

    const total = totalResult[0]?.value ?? 0;

    return reply.success({
      records,
      pagination: {
        page: Number(page),
        limit: Number(limit),
        total,
        totalPages: Math.ceil(total / Number(limit)) || 1,
      },
    });
  });

  // GET Single Record
  fastify.get('/<%= entity.tableName %>/:id', async (request: FastifyRequest, reply: FastifyReply) => {
    const { id } = request.params as { id: string };
    const [record] = await fastify.db.select().from(<%= entity.tableName %>).where(eq(<%= entity.tableName %>.id, id)).limit(1);

    if (!record) {
      throw new ApiError('Record not found', 404, 'NOT_FOUND');
    }

    return reply.success({ record });
  });

  // POST Create
  fastify.post('/<%= entity.tableName %>', async (request: FastifyRequest, reply: FastifyReply) => {
    const payload = request.body as Record<string, unknown>;
    const [record] = await fastify.db.insert(<%= entity.tableName %>).values(payload as any).returning();

    return reply.success({ record }, 'Created successfully', 201);
  });

  // PUT Update
  fastify.put('/<%= entity.tableName %>/:id', async (request: FastifyRequest, reply: FastifyReply) => {
    const { id } = request.params as { id: string };
    const payload = request.body as Record<string, unknown>;

    const [record] = await fastify.db
      .update(<%= entity.tableName %>)
      .set({ ...payload, updatedAt: new Date() } as any)
      .where(eq(<%= entity.tableName %>.id, id))
      .returning();

    if (!record) {
      throw new ApiError('Record not found', 404, 'NOT_FOUND');
    }

    return reply.success({ record }, 'Updated successfully');
  });

  // DELETE
  fastify.delete('/<%= entity.tableName %>/:id', async (request: FastifyRequest, reply: FastifyReply) => {
    const { id } = request.params as { id: string };
    const [record] = await fastify.db.delete(<%= entity.tableName %>).where(eq(<%= entity.tableName %>.id, id)).returning();

    if (!record) {
      throw new ApiError('Record not found', 404, 'NOT_FOUND');
    }

    return reply.success(null, 'Deleted successfully');
  });
}
