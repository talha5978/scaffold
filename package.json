{
	"name": "scaffold",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"dev": "dotenv -- turbo run dev",
		"build": "dotenv -- turbo run build",
		"start": "dotenv -- turbo run start",
		"api:dev": "dotenv -- turbo run dev --filter=@workspace/api",
		"api:build": "dotenv -- turbo run build --filter=@workspace/api",
		"api:start": "dotenv -- turbo run start --filter=@workspace/api",
		"web:dev": "dotenv -- turbo run dev --filter=@workspace/web",
		"web:build": "dotenv -- turbo run build --filter=@workspace/web",
		"web:start": "dotenv -- turbo run start --filter=@workspace/web",
		"format": "prettier . --write \"**/*.{js,ts,tsx,jsx,json,md,css,scss,yaml}\"",
		"ws:add": "node scripts/add-package.js"
	},
	"lint-staged": {
		"*.{js,ts,tsx,jsx,json,md,css,scss,yaml}": "prettier --write"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@11.1.1",
	"type": "module",
	"devDependencies": {
		"dotenv-cli": "^11.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.1.1",
		"prettier": "^3.9.6",
		"turbo": "^2.10.6"
	}
}
